# ==============================================================
# NEXA SiagaRT - Git Ignore Rules
# ==============================================================

# 1. CRITICAL SECURITY: Environment variables & API keys
# NEVER push real API keys or tokens to public repositories!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# 2. Dependencies
node_modules/
/.pnp
.pnp.js

# 3. Production build output
dist/
dist-ssr/
build/

# 4. Runtime & Dynamic Testing Data
# Uploaded disaster photos from citizens
server/uploads/*
!server/uploads/.gitkeep

# Local JSON database (auto-seeded by server/db.js on first run)
server/data/nexa.db.json
!server/data/.gitkeep

# 5. Logs & debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# 6. Operating System & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
