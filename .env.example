# ==============================================================
# NEXA (SiagaRT) Environment Configuration
# ==============================================================

# 1. GOOGLE GEMINI API KEY
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
# Digunakan untuk:
# - Task 1: Anti-Spam & Mismatch Check (Gemini Vision)
# - Task 2: Privacy Masking (UU PDP)
# - Task 3: Severity & SOP Action Plan Drafting (Gemini LLM)
GEMINI_API_KEY=

# 2. TELEGRAM BOT CONFIGURATION (OPSIONAL)
# Dapatkan dari @BotFather di Telegram (https://t.me/BotFather)
# Jika dikosongkan, simulator visual Telegram di web tetap berfungsi 100%
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=NexaSiagaBot
# Secret token acak untuk memverifikasi keaslian webhook dari server resmi Telegram
# Dikirim oleh Telegram dalam header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# 3. SERVER CONFIGURATION
PORT=5001
NODE_ENV=development

# 4. DATABASE CONFIGURATION (POSTGRESQL / SUPABASE)
# Dapatkan gratis di: https://supabase.com atau https://neon.tech
# Contoh: postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Jika dikosongkan, backend otomatis menggunakan penyimpanan lokal nexa.db.json
DATABASE_URL=

# 5. ADMIN SECURITY KEY
# Kunci rahasia untuk melindungi endpoint administratif (Reset Database / Purge)
ADMIN_SECRET_KEY=
